# Copy this to .env and fill in real values. Never commit .env.
# This file is for LOCAL DEVELOPMENT only — see SECURITY.md for production guidance.

# "mock" runs against fake data (safe, works on any OS, no MT5 needed).
# "real" connects to an actual running MT5 terminal (Windows only).
MT5_CLIENT_MODE=mock

# Only read by the real client. The MT5 terminal must already be installed,
# running, and logged into your Exness account on this machine — this project
# does not store or submit your Exness password anywhere.
MT5_TERMINAL_PATH=

# Safety switch — see TRADING_MODES.md. Trading tools are not implemented yet
# in this stage regardless of this value.
TRADING_MODE=READ_ONLY
